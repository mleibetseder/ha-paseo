{
  "entity": {
    "binary_sensor": {
      "bridge_online": {
        "default": "mdi:lan-disconnect",
        "state": {
          "on": "mdi:lan-connect"
        }
      },
      "needs_attention": {
        "default": "mdi:check-circle-outline",
        "state": {
          "on": "mdi:alert-circle-outline"
        }
      },
      "agent_working": {
        "default": "mdi:robot-outline",
        "state": {
          "on": "mdi:robot-happy"
        }
      }
    },
    "sensor": {
      "last_push": {
        "default": "mdi:clock-check-outline"
      },
      "active_agents": {
        "default": "mdi:robot"
      },
      "open_agents": {
        "default": "mdi:robot-outline"
      },
      "quota_waiting": {
        "default": "mdi:gauge-empty"
      },
      "ci_queue": {
        "default": "mdi:server-network",
        "state": {
          "idle": "mdi:sleep",
          "running": "mdi:play-circle-outline",
          "queued": "mdi:timer-sand",
          "blocked": "mdi:block-helper"
        }
      }
    }
  },
  "services": {
    "resume_quota_agent": {
      "service": "mdi:play-speed"
    },
    "cancel_ci_run": {
      "service": "mdi:cancel"
    }
  }
}
