      "project_active_ticket": {
        "default": "mdi:ticket-outline"
      },
      "project_open_questions": {
        "default": "mdi:help-circle-outline"
      },
      "project_stuck": {
        "default": "mdi:alert-octagon-outline"
      },
      "project_deliverables": {
        "default": "mdi:package-variant-closed"
      },
      "project_last_update": {
        "default": "mdi:clock-outline"
      }
